{
  "manifest_version": 3,
  "name": "FollowUp Copilot",
  "description": "Sends your follow-up message to each chat in Meta Business Suite and moves chats you can't message to Done.",
  "version": "1.0.0",
  "permissions": ["storage", "unlimitedStorage", "sidePanel"],
  "host_permissions": ["https://business.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open FollowUp Copilot", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://business.facebook.com/*"],
      "js": ["engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
